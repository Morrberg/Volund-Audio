{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Völund Audio",
  "version": "0.8.0",
  "identifier": "se.volund.audio",
  "build": {
    "frontendDist": "static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Völund Audio",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "AudioVideo",
    "shortDescription": "Local stem editor, mixing and mastering",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
